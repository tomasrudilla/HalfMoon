# Copiá este archivo a .env y completá con la URL de Neon:
#   cp .env.example .env
#
# Pedile a Toli la DATABASE_URL del proyecto compartido en Neon,
# o creá tu propia base y ejecutá docs/schema-init.sql + docs/sql/catalog-and-canvas-migration.sql

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# URL pública canónica (sin slash final). Usada para canonical, Open Graph y sitemap.
VITE_SITE_URL="https://halfmoon.com.ar"

# Envío de mails (opcional — sin esto el diseño y el presupuesto se guardan igual,
# sólo que no sale ninguna notificación y el panel lo avisa).
#
# Con Gmail NO sirve la contraseña normal de la cuenta: hay que generar una
# "contraseña de aplicación" de 16 caracteres.
#   1. Activá la verificación en 2 pasos en myaccount.google.com/security
#   2. Entrá a myaccount.google.com/apppasswords y creá una (ej: "HalfMoon")
#   3. Pegá los 16 caracteres SIN espacios en SMTP_PASS
#
# Ojo: nodemon no vigila este archivo, así que después de tocarlo hay que
# reiniciar `npm run api` a mano para que tome los valores nuevos.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="contrasena-de-aplicacion-16-caracteres"
SMTP_FROM="tu-email@gmail.com"
