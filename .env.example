# Copiá este archivo a .env y completá con la URL de Neon:
#   cp .env.example .env
#
# Pedile a Toli la DATABASE_URL del proyecto compartido en Neon,
# o creá tu propia base y ejecutá docs/schema-init.sql + docs/sql/catalog-and-canvas-migration.sql

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Email del personalizador (opcional — sin esto el diseño se guarda pero no manda mail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password"
SMTP_FROM="tu-email@gmail.com"
